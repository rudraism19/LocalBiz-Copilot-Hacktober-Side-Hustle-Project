# ==============================================================================
# LocalBiz Copilot — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Inference Configuration
# ------------------------------------------------------------------------------
# Active AI provider: 'local_transformers' (default) or 'huggingface_inference'
AI_PROVIDER=local_transformers

# Target Open-Weight Model Checkpoint:
# - Qwen/Qwen2.5-1.5B-Instruct (Apache 2.0, ungated, runs smoothly on CPU)
# - google/gemma-4-E4B-it (Google Gemma Terms, requires accepted terms on HF)
AI_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# URL of the local Python FastAPI inference microservice
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional authentication key if the AI service is hosted behind an API gateway
AI_SERVICE_API_KEY=

# Inference device: 'auto' (detects CUDA GPU, falls back to CPU), 'cuda', or 'cpu'
AI_DEVICE=auto

# Maximum generated tokens for briefings and marketing copy
AI_MAX_NEW_TOKENS=512

# Request timeout in seconds for model generation
AI_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# 2. Hosted Inference (Optional Hugging Face Provider)
# ------------------------------------------------------------------------------
# If AI_PROVIDER=huggingface_inference, provide your server-side Hugging Face token.
# Never expose this token in client-side code!
HF_TOKEN=

# ------------------------------------------------------------------------------
# 3. Database Persistence (Optional Supabase Cloud PostgreSQL)
# ------------------------------------------------------------------------------
# If left empty, the application automatically uses zero-config local disk
# storage at data/local-biz-store.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
